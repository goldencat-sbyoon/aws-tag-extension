{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowInvokeForConfiguredEndpoint",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "execute-api:Invoke",
      "Resource": "execute-api:/*"
    },
    {
      "Sid": "DenyUnlessFromApprovedVpcEndpoint",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "execute-api:Invoke",
      "Resource": "execute-api:/*",
      "Condition": {
        "StringNotEquals": {
          "aws:SourceVpce": "vpce-REPLACE_WITH_APPROVED_ENDPOINT_ID"
        }
      }
    }
  ]
}
